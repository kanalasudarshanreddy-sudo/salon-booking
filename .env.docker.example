# --- docker compose environment example ---
# Copy to `.env` in the repo root; `docker compose` reads it automatically.

# Postgres
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salon

# Backend
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SALON_TZ=Asia/Kolkata
ADMIN_EMAIL=admin@salon.test
ADMIN_PASSWORD=change-me

# CORS: the browser-facing frontend origin (published frontend port).
CORS_ORIGINS=http://localhost:8080

# Frontend build arg: the browser-facing backend URL (published backend port).
VITE_API_BASE=http://localhost:8000
