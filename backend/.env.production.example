# --- Backend PRODUCTION configuration example ---
# Copy to `.env` on your host (or set these as platform env vars) and adjust.
# Never commit real secrets.

# Postgres connection. `postgres://` and `postgresql://` are accepted and
# normalized to the psycopg driver automatically (see app/db.py).
# Example (managed provider):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# JWT signing secret — MUST be a long, random, secret value in production.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed frontend origin(s), comma-separated. Set to your deployed frontend URL.
CORS_ORIGINS=https://your-frontend.example.com

# Availability engine.
SLOT_INTERVAL_MINUTES=15
BOOKING_BUFFER_MINUTES=0

# Salon local timezone (IANA name). Drives working hours + past-slot cutoff.
SALON_TZ=Asia/Kolkata

# Seed admin credentials (used by `python -m app.seed`). Change for production.
ADMIN_EMAIL=admin@salon.test
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Optional: gunicorn worker count (Docker CMD reads this).
WEB_CONCURRENCY=2
