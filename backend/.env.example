# Backend configuration (copy to .env and adjust)
# SQLite for dev; swap to a Postgres URL for production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/salon
DATABASE_URL=sqlite:///./salon.db

# JWT signing secret — CHANGE THIS in production
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Availability engine defaults
SLOT_INTERVAL_MINUTES=15
BOOKING_BUFFER_MINUTES=0

# Seed admin credentials
ADMIN_EMAIL=admin@salon.test
ADMIN_PASSWORD=admin12345
